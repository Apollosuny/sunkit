{
  "name": "@sunkitjs/react-time",
  "version": "0.0.0",
  "description": "Hydration-safe dates for React: live relative time, local time and countdowns on one shared, wall-clock-aligned clock with server time offset. SSR/RSC-ready, zero dependencies.",
  "keywords": [
    "react",
    "time",
    "relative-time",
    "time-ago",
    "timeago",
    "countdown",
    "clock",
    "use-now",
    "hydration",
    "ssr",
    "nextjs",
    "server-components",
    "intl",
    "timezone",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "apollosuny",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apollosuny/sunkit.git",
    "directory": "packages/react-time"
  },
  "bugs": {
    "url": "https://github.com/Apollosuny/sunkit/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
